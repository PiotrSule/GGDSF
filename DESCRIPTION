Encoding: UTF-8
LazyData: true
Depends:
    R (>= 4.1.0)
Imports:
    stats
Suggests:
    numDeriv,
    goftest,
    ggplot2,
    patchwork,
    survival,
    MASS
Config/roxygen2/version: 8.1.1
